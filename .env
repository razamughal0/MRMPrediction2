# ==============================================================================
# AIR CAMPUS X — ENVIRONMENT TEMPLATE (.env.example)
# Copy this file to `.env` and fill in any optional external LLM API keys.
# Note: The AI Chatbot works out-of-the-box using the Built-in Hybrid RAG Engine
# even before you paste an external LLM API key!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE (PostgreSQL + Drizzle ORM)
# ------------------------------------------------------------------------------
# --- Database (required) ---
DATABASE_URL=postgresql://neondb_owner:npg_T4sfp5oAkqDw@ep-frosty-fire-b8pp8pk5-pooler.c-14.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
SECRET_SESSION=qwerfs
# ------------------------------------------------------------------------------
# 2. APPLICATION & CAMPUS METADATA  
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="AIR CAMPUS X"
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_UNIVERSITY_OFFICIAL_URL=https://khi.au.edu.pk
NEXT_PUBLIC_CAMPUS_LAT=24.8924
NEXT_PUBLIC_CAMPUS_LNG=67.0747
NEXT_PUBLIC_ENABLE_3D_MAP=true

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & JWT SESSION SECURITY (jose + bcryptjs)
# ------------------------------------------------------------------------------
# Generate a strong secret via: openssl rand -hex 32
SESSION_SECRET=your_64_char_random_session_secret_here
SESSION_COOKIE_NAME=aircampus_session
SESSION_MAX_AGE_DAYS=7

# ------------------------------------------------------------------------------
# 4. AIR CAMPUS X AI ENGINE & EXTERNAL LLM APIS (src/lib/ai.ts -> /api/ai/*)
# ------------------------------------------------------------------------------
# Supported AI_PROVIDER values: auto | gemini | groq | openai | openrouter | huggingface | local_rag
AI_PROVIDER=auto
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=900

# [Recommended Free Option 1] Google Gemini API
# Endpoint: https://generativelanguage.googleapis.com/v1beta/models/{GEMINI_MODEL}:generateContent
# Get key:  https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# [Recommended Free Option 2] Groq Cloud API
# Endpoint: https://api.groq.com/openai/v1/chat/completions
# Get key:  https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# [Option 3] OpenAI API
# Endpoint: https://api.openai.com/v1/chat/completions
# Get key:  https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# [Option 4] OpenRouter API
# Endpoint: https://openrouter.ai/api/v1/chat/completions
# Get key:  https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# [Option 5] Hugging Face Inference Router API
# Endpoint: https://router.huggingface.co/v1/chat/completions
# Get key:  https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct

# ==============================================================================
# INTERNAL REST API ROUTES USED BY AIR CAMPUS X:
# - GET   /api/health                       (PostgreSQL health check)
# - POST  /api/auth/login                   (Role-validated JWT login)
# - POST  /api/auth/logout                  (Session termination)
# - GET   /api/auth/me                      (Current session & profile)
# - POST  /api/auth/forgot-password         (Password reset request)
# - POST  /api/ai/chat                      (RAG Campus & Teaching Chatbot)
# - GET   /api/ai/status                    (Active AI provider & doc count)
# - POST  /api/ai/search                    (Knowledge Base hybrid search)
# - POST  /api/ai/classify-complaint        (AI complaint category/priority)
# - POST  /api/ai/complaint-classification  (Alias for complaint intelligence)
# - POST  /api/ai/report-summary            (Admin operational AI report)
# - GET   /api/complaints | POST /api/complaints
# - GET   /api/knowledge  | POST /api/knowledge | PATCH /api/knowledge
# - PATCH /api/notifications
# ==============================================================================
